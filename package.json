{
  "name": "dsh-monitor",
  "version": "0.1.0-local",
  "private": true,
  "type": "module",
  "description": "Background shell and path monitors that wake the DeepSeek Harness session, ported from pi-event-monitor",
  "license": "MIT",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "exports": {
    ".": "./index.js"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    }
  },
  "files": [
    "index.js",
    "batch.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "link-dsh": "node scripts/link-dsh.mjs",
    "test": "node --test test/*.test.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2"
  }
}
